<style>
.smm-refills { color:#183554; padding:28px 20px 48px; }
.smm-refills *, .smm-refills *::before, .smm-refills *::after { box-sizing:border-box; }
.smm-refills > .container-fluid { max-width:1320px; padding:0; margin:0 auto; }
.smm-refills > .paddingbody { display:none; }
.smm-refills #order-page { padding:0; background:#fff; border:1px solid #d9e5f1; border-radius:10px; box-shadow:0 4px 18px rgba(35,71,110,.07); overflow-x:auto; }
/* Remove shared theme spacing between the card and table. */
.smm-refills #order-page { padding:0 !important; }
.smm-refills #order-page .table { margin:0 !important; border-spacing:0 !important; }
.smm-refills #order-page .table { width:100%; min-width:760px; margin:0; border-collapse:collapse; }
.smm-refills #order-page th, .smm-refills #order-page td { padding:15px 13px; border-bottom:1px solid #e2ebf4; vertical-align:middle; font-size:15px; line-height:1.6; }
.smm-refills #order-page th { background:#f1f6fc; color:#24435f; white-space:nowrap; }
.smm-refills #order-page td { overflow-wrap:anywhere; }
/* Keep identifiers and dates readable while the table scrolls on small screens. */
.smm-refills #order-page .table { table-layout:auto !important; }
.smm-refills #order-page th:nth-child(1), .smm-refills #order-page td:nth-child(1) { min-width:90px; }
.smm-refills #order-page th:nth-child(2), .smm-refills #order-page td:nth-child(2) { width:120px; min-width:120px; max-width:120px; }
.smm-refills #order-page td:nth-child(1), .smm-refills #order-page td:nth-child(1) * { white-space:nowrap !important; overflow-wrap:normal !important; word-break:normal !important; }
.smm-refills #order-page td:nth-child(2), .smm-refills #order-page td:nth-child(2) * { white-space:normal !important; overflow-wrap:normal !important; word-break:normal !important; }
.smm-refills #order-page th:nth-child(6), .smm-refills #order-page td:nth-child(6) { min-width:125px; }
.smm-refills #order-page td:nth-child(6), .smm-refills #order-page td:nth-child(6) * { overflow-wrap:normal !important; word-break:normal !important; }
.smm-refills #order-page .table thead th, .smm-refills #order-page .table thead td { background:#2B3E50 !important; color:#fff !important; }
.smm-refills #order-page tbody tr:hover { background:#f8fbfe; }
.smm-refills .pagination { margin:4px 0 20px; }
.smm-refills .pagination a, .smm-refills .pagination span { border-color:#d9e5f1; color:#315679; }
.smm-refills a:focus-visible, .smm-refills button:focus-visible { outline:3px solid #78b5e7; outline-offset:2px; }
@media (max-width:767px) { .smm-refills { padding:18px 12px 32px; } .smm-refills #order-page th, .smm-refills #order-page td { padding:11px; font-size:15px; } }

.smm-refills a, .smm-refills button, .smm-refills input, .smm-refills select, .smm-refills textarea { transition:background-color .16s ease, border-color .16s ease, box-shadow .16s ease, color .16s ease; }
@media (prefers-reduced-motion:reduce) { .smm-refills a, .smm-refills button, .smm-refills input, .smm-refills select, .smm-refills textarea { transition:none; } }

/* Form focus: suppress the theme outline while retaining a visible focus indicator. */
.smm-refills input:focus, .smm-refills select:focus, .smm-refills textarea:focus { outline:none !important; border-color:#2B3E50 !important; box-shadow:0 0 0 2px rgba(43,62,80,.22) !important; }
.smm-refills input:focus-visible, .smm-refills select:focus-visible, .smm-refills textarea:focus-visible { outline:none !important; }

/* Keep the pressed state consistent with the page's button design. */
.smm-refills button:active, .smm-refills input[type="submit"]:active, .smm-refills a.btn:active { box-shadow:none !important; }
.smm-refills button[type="submit"]:active, .smm-refills input[type="submit"]:active, .smm-refills .btn-primary:active { background-color:#1D2E3E !important; border-color:#1D2E3E !important; color:#fff !important; }

/* Shared theme accent for panel-provided primary actions and table links. */
.smm-refills .btn-primary { background-color:#2B3E50 !important; border-color:#2B3E50 !important; color:#fff !important; }
.smm-refills .btn-primary:hover, .smm-refills .btn-primary:focus, .smm-refills .btn-primary:active { background-color:#1D2E3E !important; border-color:#1D2E3E !important; color:#fff !important; }
.smm-refills .table a:not(.btn) { color:#2B3E50; }

/* Consistent table heading colors across the site. */
.smm-refills #order-page .table thead,
.smm-refills #order-page .table thead tr,
.smm-refills #order-page .table thead tr > th,
.smm-refills #order-page .table thead tr > td,
.smm-refills #order-page .table thead tr > :last-child { background-color:#e4f0fb !important; color:#2B3E50 !important; }

/* Match the search field's inset focus style on form fields. */
.smm-refills input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]):not([type="hidden"]):focus,
.smm-refills textarea:focus, .smm-refills select:focus { outline:none !important; border-color:#2B3E50 !important; box-shadow:inset 0 0 0 1px #2B3E50 !important; }

/* Consistent readable table text and form controls on desktop and mobile. */
.smm-refills table th:not(.service_cat_header), .smm-refills table td:not(.service_cat_header),
.smm-refills table .btn, .smm-refills input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]),
.smm-refills select, .smm-refills textarea, .smm-refills button, .smm-refills label { font-size:15px !important; }

/* Keep body copy readable across screen sizes. */
.smm-refills, .smm-refills p, .smm-refills li { font-size:15px !important; }

/* Brighter hover for theme-colored actions; active and disabled states remain distinct. */
@media (hover:hover) {
  .smm-refills button[type="submit"]:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]),
  .smm-refills input[type="submit"]:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]),
  .smm-refills .btn-primary:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]) { background-color:#405E78 !important; border-color:#405E78 !important; color:#fff !important; }
}
</style>
<div class="smm-refills">
	
	
		<div class="paddingbody"></div>
		<div class="container-fluid container-fluid-spacious">
			<div class="row">
				
				<div class="col-md-12">
					<div id="order-page" class="well well-float table-responsive">
						<table class="table ">
							<thead>
								<tr>
									<th>[refill.table.id]</th>
									<th>[refill.table.Date]</th>
									<th>[refill.table.Order_id]</th>
									<th>[refill.table.Link]</th>
									<th>[refill.table.Service_name]</th>
									<th>[refill.table.Status]</th>
								</tr>
							</thead>
							<tbody>
								[template.refill.table.items]
							</tbody>
						</table>
					</div>
					
					<ul class="pagination ">
						[template.pages.pagination.items]
					</ul>
					
				</div>
			</div>
		</div>
</div>
<script>
(function () {
  'use strict';
  var table = document.querySelector('.smm-refills #order-page .table');
  if (!table) return;
  function wrapDates() {
    Array.prototype.forEach.call(table.querySelectorAll('tbody tr'), function (row) {
      var cell = row.cells[1];
      if (!cell) return;
      var walker = document.createTreeWalker(cell, NodeFilter.SHOW_TEXT, null);
      var node;
      while ((node = walker.nextNode())) {
        var match = /(\b\d{4}-\d{2}-\d{2})([ \t\u00a0]+)(\d{1,2}:\d{2}(?::\d{2})?)/.exec(node.nodeValue);
        if (!match) continue;
        var afterDate = node.splitText(match.index + match[1].length);
        afterDate.deleteData(0, match[2].length);
        afterDate.parentNode.insertBefore(document.createElement('br'), afterDate);
        break;
      }
    });
  }
  wrapDates();
  if (window.MutationObserver) {
    var pending = false;
    var observer = new MutationObserver(function () {
      if (pending) return;
      pending = true;
      window.requestAnimationFrame(function () { pending = false; wrapDates(); });
    });
    observer.observe(table, { childList:true, subtree:true, characterData:true });
  }
}());
</script>
