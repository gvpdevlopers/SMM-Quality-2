<style>
.smm-dripfeed { color:#183554; padding:28px 20px 48px; }
.smm-dripfeed, .smm-dripfeed *, .smm-dripfeed *::before, .smm-dripfeed *::after { box-sizing:border-box; }
.smm-dripfeed .smm-dripfeed-wrap { display:block !important; width:100% !important; max-width:1440px; margin:0 auto; }
.smm-dripfeed .smm-dripfeed-wrap > .smm-dripfeed-tabs, .smm-dripfeed .smm-dripfeed-wrap > .smm-dripfeed-card, .smm-dripfeed .smm-dripfeed-wrap > .smm-dripfeed-content { display:block; float:none !important; clear:both; width:100% !important; max-width:none !important; }
.smm-dripfeed .smm-dripfeed-content { overflow-wrap:anywhere; }
.smm-dripfeed .smm-dripfeed-content:empty { display:none; }
.smm-dripfeed .smm-dripfeed-tabs { margin:0 0 20px !important; padding:0 !important; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills { display:flex !important; flex-wrap:wrap; gap:8px; padding:0 !important; margin-bottom:10px !important; list-style:none; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li { float:none !important; margin:0 !important; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li > a { display:block; padding:10px 15px; border:1px solid #d5e3f1 !important; border-radius:6px !important; background:#fff !important; color:#315679 !important; text-decoration:none; font-size:14px; line-height:1.5; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li > a:hover, .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li > a:focus { background:#edf5fc !important; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a, .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:hover, .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:focus { background:#2B3E50 !important; border-color:#2B3E50 !important; border-radius:6px !important; color:#fff !important; }
.smm-dripfeed .smm-dripfeed-select-compat { display:none; }
.smm-dripfeed .smm-dripfeed-card { min-width:0; background:#fff !important; border:1px solid #d9e5f1 !important; border-radius:10px !important; box-shadow:0 4px 18px rgba(35,71,110,.07); overflow:hidden; }
.smm-dripfeed .smm-dripfeed-search { padding:20px 22px; border-bottom:1px solid #e2ebf4; }
.smm-dripfeed #history-search { max-width:550px; margin:0; }
.smm-dripfeed #history-search .input-group { display:flex; width:100%; }
.smm-dripfeed #history-search .form-control { display:block; flex:1 1 auto; min-width:0; width:100%; height:46px; padding:10px 13px; border:1px solid #cbdced !important; border-radius:6px 0 0 6px !important; background:#fff !important; color:#183554; box-shadow:none; }
.smm-dripfeed #history-search .input-group-btn { width:auto; flex:0 0 auto; display:block; }
.smm-dripfeed #history-search button { height:46px; min-width:50px; padding:0 14px; border:1px solid #2B3E50 !important; border-radius:0 6px 6px 0 !important; background:#2B3E50 !important; color:#fff !important; }
.smm-dripfeed #history-search button:hover { background:#1D2E3E !important; }
.smm-dripfeed #order-page { width:100%; overflow-x:auto; }
.smm-dripfeed #order-page .table { width:100%; min-width:1000px; margin:0; border-collapse:collapse; }
.smm-dripfeed #order-page th, .smm-dripfeed #order-page td { padding:13px 12px; border-bottom:1px solid #e2ebf4; font-size:13px; line-height:1.5; vertical-align:middle; }
.smm-dripfeed #order-page th { background:#f1f6fc !important; color:#24435f; white-space:nowrap; }
/* Keep IDs, numbers and statuses intact; let the table scroll instead of splitting values. */
.smm-dripfeed #order-page td { overflow-wrap:normal; word-break:normal; }
.smm-dripfeed #order-page th:nth-child(1), .smm-dripfeed #order-page td:nth-child(1),
.smm-dripfeed #order-page th:nth-child(4), .smm-dripfeed #order-page td:nth-child(4),
.smm-dripfeed #order-page th:nth-child(5), .smm-dripfeed #order-page td:nth-child(5),
.smm-dripfeed #order-page th:nth-child(7), .smm-dripfeed #order-page td:nth-child(7),
.smm-dripfeed #order-page th:nth-child(8), .smm-dripfeed #order-page td:nth-child(8),
.smm-dripfeed #order-page th:nth-child(9), .smm-dripfeed #order-page td:nth-child(9),
.smm-dripfeed #order-page th:nth-child(10), .smm-dripfeed #order-page td:nth-child(10) { white-space:nowrap; }
.smm-dripfeed #order-page th:nth-child(3), .smm-dripfeed #order-page td:nth-child(3) { min-width:230px; }
.smm-dripfeed #order-page td:nth-child(3) { overflow-wrap:anywhere; }
.smm-dripfeed #order-page th:nth-child(6), .smm-dripfeed #order-page td:nth-child(6) { min-width:290px; }
.smm-dripfeed #order-page td:nth-child(6) { overflow-wrap:anywhere; }
.smm-dripfeed #order-page tbody tr:hover { background:#f8fbfe; }
.smm-dripfeed .smm-dripfeed-pagination { padding:0 22px 16px; }
.smm-dripfeed .smm-dripfeed-pagination .pagination { margin:16px 0 0; }
.smm-dripfeed a:focus-visible, .smm-dripfeed button:focus-visible, .smm-dripfeed input:focus-visible { outline:3px solid #78b5e7; outline-offset:2px; }
.smm-dripfeed a[href^="tel"], .smm-dripfeed a[x-apple-data-detectors] { color:inherit !important; text-decoration:none !important; pointer-events:none !important; }
@media(max-width:767px) { .smm-dripfeed { padding:18px 12px 32px; } .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li > a { padding:9px 11px; font-size:13px; } .smm-dripfeed .smm-dripfeed-search { padding:16px; } .smm-dripfeed .smm-dripfeed-pagination { padding:0 16px 16px; } }

/* Form focus: suppress the theme outline while retaining a visible focus indicator. */
.smm-dripfeed input:focus, .smm-dripfeed select:focus, .smm-dripfeed textarea:focus { outline:none !important; border-color:#2B3E50 !important; box-shadow:0 0 0 2px rgba(43,62,80,.22) !important; }
.smm-dripfeed input:focus-visible, .smm-dripfeed select:focus-visible, .smm-dripfeed textarea:focus-visible { outline:none !important; }

/* Keep the pressed state consistent with the page's button design. */
.smm-dripfeed button:active, .smm-dripfeed input[type="submit"]:active, .smm-dripfeed a.btn:active { box-shadow:none !important; }
.smm-dripfeed button[type="submit"]:active, .smm-dripfeed input[type="submit"]:active, .smm-dripfeed .btn-primary:active { background-color:#1D2E3E !important; border-color:#1D2E3E !important; color:#fff !important; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a, .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:hover, .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:focus, .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:active { background:#2B3E50 !important; color:#fff !important; border:1px solid #2B3E50 !important; border-radius:6px !important; box-shadow:none !important; }

/* Shared theme accent for panel-provided primary actions and table links. */
.smm-dripfeed .btn-primary { background-color:#2B3E50 !important; border-color:#2B3E50 !important; color:#fff !important; }
.smm-dripfeed .btn-primary:hover, .smm-dripfeed .btn-primary:focus, .smm-dripfeed .btn-primary:active { background-color:#1D2E3E !important; border-color:#1D2E3E !important; color:#fff !important; }
.smm-dripfeed .table a:not(.btn) { color:#2B3E50; }

/* Keep the panel's status links visible and consistently styled on desktop and mobile. */
.smm-dripfeed .smm-dripfeed-toolbar > nav.smm-dripfeed-tabs { display:block !important; visibility:visible !important; position:static !important; height:auto !important; max-height:none !important; overflow:visible !important; opacity:1 !important; }
.smm-dripfeed .smm-dripfeed-tabs ul.nav.nav-pills { display:flex !important; visibility:visible !important; position:static !important; width:100% !important; margin:0 0 12px !important; padding:0 0 4px !important; list-style:none; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li { display:block !important; visibility:visible !important; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active { background:transparent !important; border:0 !important; box-shadow:none !important; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li > a { display:block !important; border:1px solid #d2e0ed !important; border-radius:7px !important; background:#f3f7fb !important; color:#24435f !important; font-weight:600 !important; text-decoration:none !important; box-shadow:none !important; white-space:nowrap; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a,
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:hover,
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:focus,
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li.active > a:active { background:#2B3E50 !important; border-color:#91aac0 !important; border-radius:7px !important; color:#fff !important; box-shadow:none !important; }
.smm-dripfeed #history-search .form-control { outline:none !important; border:1px solid #cbdced !important; box-shadow:none !important; }
.smm-dripfeed #history-search .form-control:focus { border-color:#2B3E50 !important; box-shadow:inset 0 0 0 1px #2B3E50 !important; }
.smm-dripfeed #history-search button, .smm-dripfeed #history-search button:focus { background:#2B3E50 !important; border-color:#91aac0 !important; color:#fff !important; }
.smm-dripfeed #history-search button:hover, .smm-dripfeed #history-search button:active { background:#1D2E3E !important; border-color:#1D2E3E !important; }
.smm-dripfeed #order-page thead th, .smm-dripfeed #order-page thead td { background:#2B3E50 !important; color:#fff !important; }
.smm-dripfeed #order-page th:nth-child(2), .smm-dripfeed #order-page td:nth-child(2) { width:120px; min-width:120px; max-width:120px; }
.smm-dripfeed #order-page td:nth-child(2) { white-space:normal !important; overflow-wrap:normal !important; word-break:normal !important; }
@media (max-width:767px) {
  .smm-dripfeed .smm-dripfeed-toolbar > nav.smm-dripfeed-tabs { overflow-x:auto !important; overflow-y:hidden !important; -webkit-overflow-scrolling:touch; scrollbar-width:none !important; -ms-overflow-style:none; }
  .smm-dripfeed .smm-dripfeed-toolbar > nav.smm-dripfeed-tabs::-webkit-scrollbar,
  .smm-dripfeed .smm-dripfeed-tabs ul.nav.nav-pills::-webkit-scrollbar { display:none !important; width:0 !important; height:0 !important; }
  .smm-dripfeed .smm-dripfeed-tabs ul.nav.nav-pills { flex-wrap:nowrap !important; width:max-content !important; min-width:100%; overflow:visible !important; scrollbar-width:none !important; -ms-overflow-style:none; }
  .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li { flex:0 0 auto; }
}

/* Consistent table heading colors across the site. */
.smm-dripfeed #order-page .table thead,
.smm-dripfeed #order-page .table thead tr,
.smm-dripfeed #order-page .table thead tr > th,
.smm-dripfeed #order-page .table thead tr > td,
.smm-dripfeed #order-page .table thead tr > :last-child { background-color:#e4f0fb !important; color:#2B3E50 !important; }

/* Match the search field's inset focus style on form fields. */
.smm-dripfeed input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]):not([type="hidden"]):focus,
.smm-dripfeed textarea:focus, .smm-dripfeed select:focus { outline:none !important; border-color:#2B3E50 !important; box-shadow:inset 0 0 0 1px #2B3E50 !important; }

/* Consistent readable table text and form controls on desktop and mobile. */
.smm-dripfeed table th:not(.service_cat_header), .smm-dripfeed table td:not(.service_cat_header),
.smm-dripfeed table .btn, .smm-dripfeed input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]),
.smm-dripfeed select, .smm-dripfeed textarea, .smm-dripfeed button, .smm-dripfeed label { font-size:15px !important; }

/* Keep body copy readable across screen sizes. */
.smm-dripfeed, .smm-dripfeed p, .smm-dripfeed li { font-size:15px !important; }
.smm-dripfeed .smm-dripfeed-tabs .nav-pills > li > a { font-size:15px !important; }

/* Brighter hover for theme-colored actions; active and disabled states remain distinct. */
@media (hover:hover) {
  .smm-dripfeed button[type="submit"]:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]),
  .smm-dripfeed input[type="submit"]:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]),
  .smm-dripfeed .btn-primary:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]),
  .smm-dripfeed #history-search button:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]),
  .smm-dripfeed .smm-dripfeed-tabs .nav-pills > li > a:hover:not(:active):not(:disabled):not(.disabled):not([aria-disabled="true"]) { background-color:#405E78 !important; border-color:#405E78 !important; color:#fff !important; }
}

/* Keep filters and search together above the table. */
.smm-dripfeed .smm-dripfeed-toolbar { display:flex; align-items:center; gap:16px; margin:0 0 20px; min-width:0; }
.smm-dripfeed .smm-dripfeed-toolbar > nav.smm-dripfeed-tabs { flex:1 1 auto; min-width:0; margin:0 !important; }
.smm-dripfeed .smm-dripfeed-toolbar .smm-dripfeed-tabs ul.nav.nav-pills { margin:0 !important; }
.smm-dripfeed .smm-dripfeed-toolbar .smm-dripfeed-search { flex:0 1 380px; width:100%; min-width:0; padding:0 !important; border:0; }
.smm-dripfeed .smm-dripfeed-toolbar #history-search { width:100%; max-width:none; }
@media (max-width:767px) {
  .smm-dripfeed .smm-dripfeed-toolbar { flex-direction:column; align-items:stretch; gap:12px; }
  .smm-dripfeed .smm-dripfeed-toolbar > nav.smm-dripfeed-tabs { width:100%; flex:0 0 auto; }
  .smm-dripfeed .smm-dripfeed-toolbar .smm-dripfeed-search { flex:0 0 auto; }
}

/* Keep the search input and button aligned as one rounded control. */
.smm-dripfeed #history-search .input-group { display:flex !important; align-items:stretch; width:100%; height:46px; border:1px solid #91aac0; border-radius:6px; background:#fff; overflow:hidden; }
.smm-dripfeed #history-search .form-control { flex:1 1 0; width:0 !important; min-width:0; height:44px !important; margin:0 !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; }
.smm-dripfeed #history-search .form-control:focus { outline:none !important; border:0 !important; border-radius:5px 0 0 5px !important; box-shadow:inset 0 0 0 1px #405E78 !important; }
.smm-dripfeed #history-search .input-group-btn { display:block; flex:0 0 50px; width:50px; }
.smm-dripfeed #history-search button, .smm-dripfeed #history-search button:focus { display:block; width:50px; min-width:50px; height:44px; margin:0 !important; padding:0 !important; border:0 !important; border-left:1px solid #91aac0 !important; border-radius:0 !important; }
.smm-dripfeed #history-search button:focus-visible { outline:2px solid #fff !important; outline-offset:-4px; }
</style>
<meta name="format-detection" content="telephone=no">
<div class="smm-dripfeed"><div class="smm-dripfeed-wrap">
  <div class="smm-dripfeed-toolbar">
  <nav class="smm-dripfeed-tabs" aria-label="Filter drip-feed orders by status"><ul class="nav nav-pills ">
							
							<li class="[dripfeed.tab.all.active_class]"><a href="[dripfeed.tab.all.url-query]">[dripfeed.tab.all]</a></li>
							<li class="[dripfeed.tab.Active.active_class]"><a href="[dripfeed.tab.Active.url-query]">[dripfeed.tab.Active]</a></li>
							<li class="[dripfeed.tab.Completed.active_class]"><a href="[dripfeed.tab.Completed.url-query]">[dripfeed.tab.Completed]</a></li>
							<li class="[dripfeed.tab.Canceled.active_class]"><a href="[dripfeed.tab.Canceled.url-query]">[dripfeed.tab.Canceled]</a></li>
										
						</ul></nav>
    <div class="smm-dripfeed-search"><form action="" method="get" id="history-search">
								<div class="input-group">
									<input name="search" class="form-control" aria-label="Search drip-feed orders" placeholder="Search orders" type="text" />
									<span class="input-group-btn">
									<button type="submit" class="btn btn-default" aria-label="Search drip-feed orders"><i class="fa fa-search" aria-hidden="true"></i></button>
									</span>
								</div>
							</form></div>
  </div>
  <div class="smm-dripfeed-select-compat" aria-hidden="true"><select aria-label="Drip-feed status" tabindex="-1" class="custom-select w-full" >
							<option value="[dripfeed.tab.all.url-query]" [dripfeed.tab.all.select_class] >[dripfeed.tab.all]</option>
							<option value="[dripfeed.tab.Active.url-query]" [dripfeed.tab.Active.select_class] >[dripfeed.tab.Active]</option>
							<option value="[dripfeed.tab.Completed.url-query]" [dripfeed.tab.Completed.select_class]  >[dripfeed.tab.Completed]</option>
							<option value="[dripfeed.tab.Canceled.url-query]" [dripfeed.tab.Canceled.select_class]  >[dripfeed.tab.Canceled]</option>
						</select></div>
  <section class="smm-dripfeed-card" aria-label="Drip-feed orders">

    <div id="order-page" class="table-responsive" role="region" aria-label="Drip-feed orders table" tabindex="0"><table class="table ">
							<thead>
								<tr>
									<th >[dripfeed.table.id]</th>
									<th >[dripfeed.table.Date]</th>
									<th class="width-40">[dripfeed.table.Link]</th>
									<th >[dripfeed.table.Charge]</th>
									<th >[dripfeed.table.Quantity]</th>
									<th >[dripfeed.table.Service]</th>
									<th class="nowrap">[dripfeed.table.Runs]</th>
									<th class="nowrap">[dripfeed.table.Intervals]</th>
									<th  class="nowrap">[dripfeed.table.Total_Quantity]</th>
									<th >[dripfeed.table.Status]</th>
								</tr>
							</thead>
							<tbody>
								[template.dripfeed.table.items]
							</tbody>
						</table></div>
    <nav class="smm-dripfeed-pagination" aria-label="Drip-feed order pages"><ul class="pagination">[template.pages.pagination.items]</ul></nav>
  </section>
</div></div>

<script>
(function () {
  'use strict';
  var table = document.querySelector('.smm-dripfeed #order-page .table');
  if (!table) return;
  function wrapDates() {
    Array.prototype.forEach.call(table.querySelectorAll('tbody tr'), function (row) {
      var cell = row.cells[1];
      if (!cell) return;
      var walker = document.createTreeWalker(cell, NodeFilter.SHOW_TEXT, null);
      var node;
      while ((node = walker.nextNode())) {
        var match = /(\b\d{4}-\d{2}-\d{2})([ \t\u00a0]+)(\d{1,2}:\d{2}(?::\d{2})?)/.exec(node.nodeValue);
        if (!match) continue;
        var afterDate = node.splitText(match.index + match[1].length);
        afterDate.deleteData(0, match[2].length);
        afterDate.parentNode.insertBefore(document.createElement('br'), afterDate);
        break;
      }
    });
  }
  wrapDates();
  if (window.MutationObserver) {
    var pending = false;
    var observer = new MutationObserver(function () {
      if (pending) return;
      pending = true;
      window.requestAnimationFrame(function () { pending = false; wrapDates(); });
    });
    observer.observe(table, { childList:true, subtree:true, characterData:true });
  }
}());
</script>
