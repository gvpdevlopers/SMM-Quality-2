<!-- API page template with page-local styles. -->
<div class="smm-api-v2">
  <div class="smm-api-v2-layout">
    <aside class="smm-api-v2-sidebar" aria-label="API navigation and help">
    <nav class="smm-api-v2-card smm-api-v2-nav" aria-label="API sections">
      <a href="#smm-api-v2-overview"><i class="fas fa-th-large smm-api-v2-icon" aria-hidden="true"></i><span>Overview</span></a>
      <a href="#smm-api-v2-add-order"><i class="fas fa-plus-circle smm-api-v2-icon" aria-hidden="true"></i><span>Add Order</span></a>
      <a href="#smm-api-v2-services"><i class="fas fa-list-alt smm-api-v2-icon" aria-hidden="true"></i><span>Services List</span></a>
      <a href="#smm-api-v2-status"><i class="fas fa-clipboard-check smm-api-v2-icon" aria-hidden="true"></i><span>Order Status</span></a>
      <a href="#smm-api-v2-multiple-status"><i class="fas fa-tasks smm-api-v2-icon" aria-hidden="true"></i><span>Multiple Order Status</span></a>
      <a href="#smm-api-v2-balance"><i class="fas fa-wallet smm-api-v2-icon" aria-hidden="true"></i><span>Balance</span></a>
      <a href="#smm-api-v2-refill"><i class="fas fa-redo-alt smm-api-v2-icon" aria-hidden="true"></i><span>Refill</span></a>
      <a href="#smm-api-v2-cancel"><i class="fas fa-times-circle smm-api-v2-icon" aria-hidden="true"></i><span>Cancel</span></a>
    </nav>
      <section class="smm-api-v2-card smm-api-v2-help">
        <h2><i class="fas fa-headset smm-api-v2-icon" aria-hidden="true"></i> Need Help?</h2>
        <p>Need assistance with API integration? Contact the support team.</p>
        <a class="smm-api-v2-support-link" href="/tickets">Contact Support</a>
      </section>
    </aside>
    <div class="smm-api-v2-main">
      <section class="smm-api-v2-card smm-api-v2-overview" id="smm-api-v2-overview">
<h1><i class="fas fa-laptop-code smm-api-v2-icon" aria-hidden="true"></i> API Overview</h1>
						<table class="table table-bordered">
								<tbody>
									<tr>
										<td class="width-40">HTTP Method</td>
										<td>POST</td>
									</tr>
									<tr>
										<td>API URL</td>
										<td>
											<strong>[panel.url]/[api-docs.api-url]</strong>
										</td>
									</tr>
							
									<tr>
										<td>API KEY</td>
										<td><strong>[user.api_key]</strong></td>
									</tr>
									
									<tr>
										<td>Response format</td>
										<td>JSON</td>
									</tr>
								</tbody>
						</table>
      </section>
<section class="smm-api-v2-card smm-api-v2-endpoint" id="smm-api-v2-add-order" aria-labelledby="smm-api-v2-heading-add-order">
  <span class="smm-api-v2-number" aria-hidden="true">1</span>
  <div class="smm-api-v2-section-body"><h2 id="smm-api-v2-heading-add-order">Add Order</h2>
<p>
						</p>
						<form class="form-inline">
							<div class="form-group">
								<select class="form-control input-sm" id="service_type" aria-label="Service type">
									<option value="0" selected="selected">Default</option>
								</select>
							</div>
						</form>
						<p></p>
						
						<div id="type_0" style="">
							<table class="table table-bordered">
								<thead>
									<tr>
										<th class="width-40">Parameters</th>
										<th>Description</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>[api-docs.key]</td>
										<td>Your API key</td>
									</tr>
									<tr>
										<td>[api-docs.action]</td>
										<td>add</td>
									</tr>
									<tr>
										<td>[api-docs.service]</td>
										<td>Service ID</td>
									</tr>
									<tr>
										<td>[api-docs.url]</td>
										<td>Link to page</td>
									</tr>
									<tr>
										<td>[api-docs.quantity]</td>
										<td>Needed quantity</td>
									</tr>
									<tr>
										<td>[api-docs.comments]</td>
										<td>Comments list (encoded)</td>
									</tr>
									<tr>
										<td>[api-docs.runs]</td>
										<td>Runs to deliver</td>
									</tr>
									<tr>
										<td>[api-docs.interval]</td>
										<td>Interval in minutes</td>
									</tr>
									
								</tbody>
							</table>
						</div>
						<p><strong>Example success response</strong></p>
						<pre>[api-docs.add-order.success]</pre>
						<p><strong>Example error response</strong></p>
						<pre>{
	"error": "incorrect service type"
}
</pre>
  </div>
</section>
<section class="smm-api-v2-card smm-api-v2-endpoint" id="smm-api-v2-services" aria-labelledby="smm-api-v2-heading-services">
