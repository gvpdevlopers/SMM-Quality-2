<section class="smm-api-v2-card smm-api-v2-endpoint" id="smm-api-v2-refill" aria-labelledby="smm-api-v2-heading-refill">
  <span class="smm-api-v2-number" aria-hidden="true">6</span>
  <div class="smm-api-v2-section-body"><h2 id="smm-api-v2-heading-refill">Refill</h2>
<table class="table table-bordered">
								<thead>
