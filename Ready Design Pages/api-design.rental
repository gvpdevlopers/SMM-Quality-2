</section>
<section class="smm-api-v2-card smm-api-v2-endpoint" id="smm-api-v2-cancel" aria-labelledby="smm-api-v2-heading-cancel">
  <span class="smm-api-v2-number" aria-hidden="true">7</span>
  <div class="smm-api-v2-section-body"><h2 id="smm-api-v2-heading-cancel">Cancel</h2>
