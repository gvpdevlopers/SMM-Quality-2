							<pre>{
	"balance": 10000,
	"currency": "USD"
}
</pre>				
						
						<h4 id="smm-api-refill" class="m-t-md"><strong>Refill</strong></h4>
							<table class="table table-bordered">
								<thead>
									<tr>
										<th class="width-40">Parameters</th>
										<th>Description</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>[api-docs.key]</td>
										<td>Your API key</td>
									</tr>
									<tr>
										<td>[api-docs.action]</td>
										<td>refill</td>
									</tr>
									<tr>
										<td>[api-docs.status.order]</td>
										<td>Order ID</td>
									</tr>
								</tbody>
							</table>
							<p><strong>Example response</strong></p>
							<pre>{
	"status": "Success",
	"message": "Your order successfully added for refill. Thank you for patience."
}
</pre>
							
							<h4 id="smm-api-cancel" class="m-t-md"><strong>Cancel</strong></h4>
							<table class="table table-bordered">
								<thead>
									<tr>
										<th class="width-40">Parameters</th>
										<th>Description</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>[api-docs.key]</td>
										<td>Your API key</td>
									</tr>
									<tr>
										<td>[api-docs.action]</td>
										<td>cancel</td>
									</tr>
									<tr>
										<td>[api-docs.status.order]</td>
										<td>Order ID</td>
									</tr>
								</tbody>
							</table>
							<p><strong>Example response</strong></p>
							<pre>{
	"status": "Success",
	"message": "Your order was successfully marked for cancellation. Thank you for patience."
}
</pre>
						
						<a href="[panel.url]/api.zip" class="btn btn-default m-t" target="_blank" rel="noopener noreferrer">Example of PHP code</a>
					</div>
				</div>
			</div>
		</div>
	</div>
	
	
	
	
</div></div></div>
