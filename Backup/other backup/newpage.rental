<style>
    .sq-footer,
    .sq-footer * {
        box-sizing: border-box;
    }

    .sq-footer {
        position: relative;
        overflow: hidden;
        width: 100%;
        margin-top: 0;
        background: transparent;
        color: #f4f8fc;
        font-family: "Helvetica Neue", Arial, sans-serif;
    }

    .sq-footer::before {
        position: absolute;
        right: -180px;
        bottom: 90px;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(76, 157, 216, 0.12),
            transparent 68%
        );
        content: "";
        pointer-events: none;
    }

    .sq-footer a {
        text-decoration: none;
    }

    .sq-footer-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1480px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .sq-footer-top {
        padding: 52px 0 32px;
        border-top: 1px solid rgba(151, 201, 238, 0.12);
    }

    .sq-footer-services {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .sq-footer-group {
        min-height: 100%;
        padding: 20px 18px;
        border: 1px solid rgba(151, 201, 238, 0.14);
        border-radius: 12px;
        background: linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.045),
            rgba(255, 255, 255, 0.015)
        );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.03),
            0 8px 20px rgba(7, 19, 30, 0.08);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            background 0.25s ease;
    }

    .sq-footer-group:hover {
        border-color: rgba(132, 199, 251, 0.32);
        background: linear-gradient(
            145deg,
            rgba(84, 143, 191, 0.10),
            rgba(255, 255, 255, 0.026)
        );
        transform: translateY(-3px);
    }

    .sq-footer-group h3 {
        margin: 0 0 14px;
        background: linear-gradient(
            90deg,
            #8dccfa,
            #d9f0ff
        );
        color: #a9d8fa;
        font-size: 16px;
        line-height: 1.35;
        font-weight: 780;
        letter-spacing: -0.2px;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .sq-footer-links {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .sq-footer-links a {
        position: relative;
        display: inline-block;
        width: fit-content;
        max-width: 100%;
        padding-left: 0;
        color: #b9c6d2;
        font-size: 12px;
        line-height: 1.5;
        transition:
            color 0.2s ease,
            transform 0.2s ease;
    }

    .sq-footer-links a::before {
        position: absolute;
        top: 0.7em;
        left: 0;
        width: 0;
        height: 1px;
        background: #8dccfa;
        content: "";
        opacity: 0;
        transition:
            width 0.2s ease,
            opacity 0.2s ease;
    }

    .sq-footer-links a:hover,
    .sq-footer-links a:focus {
        padding-left: 11px;
        color: #ffffff;
        transform: translateX(2px);
    }

    .sq-footer-links a:hover::before,
    .sq-footer-links a:focus::before {
        width: 6px;
        opacity: 1;
    }

    .sq-footer-brandbar {
        display: grid;
        align-items: center;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 20px;
        margin-top: 18px;
        padding: 20px 0;
        border-top: 1px solid rgba(151, 201, 238, 0.11);
    }

    .sq-footer-brand h2 {
        margin: 0 0 4px;
        color: #f8fbff;
        font-size: 24px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .sq-footer-brand p {
        margin: 0;
        color: #92a6b8;
        font-size: 13px;
        line-height: 1.5;
    }

    .sq-footer-social {
        display: flex;
