<!-- DYNAMIC EFFECTIVE DATE -->
<script>
(function () {
    function updatePolicyDate() {
        var now = new Date();

        var options = {
            day: "2-digit",
            month: "long",
            year: "numeric"
        };

        var formattedDate = now.toLocaleDateString("en-IN", options);

        var heroDate = document.getElementById("smmq-effective-date");
        var sidebarDate = document.getElementById("smmq-sidebar-date");

        if (heroDate) {
            heroDate.textContent = formattedDate;
        }

        if (sidebarDate) {
            sidebarDate.textContent = formattedDate;
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", updatePolicyDate);
    } else {
        updatePolicyDate();
    }
})();
</script> 