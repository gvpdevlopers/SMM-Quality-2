    /*
    |--------------------------------------------------------------------------
    | Detect Current Page
    |--------------------------------------------------------------------------
    */

    const currentPage = window.location.pathname;

    if (!pageSchemas[currentPage]) {
        return;
    }

    const page = pageSchemas[currentPage];


    /*
    |--------------------------------------------------------------------------
    | Service Schema
    |--------------------------------------------------------------------------
    */

    if (page.service) {

        const serviceSchema = {

            "@context": "https://schema.org",

            "@type": "Service",

            "serviceType": page.service.serviceType,

            "name": page.service.name,

            "url": page.service.url,

            "description": page.service.description,

            "provider": {

                "@type": "Organization",

                "name": "SMMquality",

                "url": "https://www.smmquality.com/"

            },

            "areaServed": {

                "@type": "Country",

                "name": "India"

            },

            "audience": {

                "@type": "Audience",

                "audienceType": page.service.audience

            }

        };

        const serviceScript = document.createElement("script");

        serviceScript.type = "application/ld+json";

        serviceScript.textContent = JSON.stringify(serviceSchema);

        document.head.appendChild(serviceScript);

        console.log("Service Schema Injected:", serviceSchema);

    }


    /*
    |--------------------------------------------------------------------------
    | FAQ Schema (Next Phase)
    |--------------------------------------------------------------------------
    */

    if (page.faq) {

        // Will implement later

    }


    /*
    |--------------------------------------------------------------------------
    | Breadcrumb Schema
    |--------------------------------------------------------------------------
    */

    if (page.breadcrumb && page.service) {

        const breadcrumbSchema = {

            "@context": "https://schema.org",

            "@type": "BreadcrumbList",

            "itemListElement": [

                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://www.smmquality.com/"
                },

                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": page.breadcrumb.name,
                    "item": page.breadcrumb.url
                },

                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": page.service.name,
                    "item": page.service.url
                }

            ]

        };

        const breadcrumbScript = document.createElement("script");

        breadcrumbScript.type = "application/ld+json";

        breadcrumbScript.textContent = JSON.stringify(breadcrumbSchema);

        document.head.appendChild(breadcrumbScript);

        console.log("Breadcrumb Schema Injected:", breadcrumbSchema);

    }

});
