        gap: 12px;
    }

    .sq-footer-social a.sq-social-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 1px solid rgba(151, 201, 238, 0.2);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.045);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
        color: #c9e8ff;
        font-size: 16px;
        cursor: pointer;
        transition:
            transform 0.22s ease,
            border-color 0.22s ease,
            background 0.22s ease,
            color 0.22s ease;
    }

    .sq-footer-social a.sq-social-btn:hover,
    .sq-footer-social a.sq-social-btn:focus {
        border-color: rgba(132, 199, 251, 0.45);
        background: rgba(84, 143, 191, 0.16);
        color: #ffffff;
        transform: translateY(-2px);
    }

    .sq-footer-bottom {
        position: relative;
        z-index: 2;
        padding: 15px;
        border-top: 1px solid rgba(151, 201, 238, 0.10);
        background: rgba(10, 22, 34, 0.22);
        text-align: center;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .sq-footer-bottom p {
        margin: 0;
        color: #91a4b5;
        font-size: 12px;
        line-height: 1.6;
    }

    .sq-footer-bottom a {
        color: #d9efff;
        font-weight: 700;
    }

    .sq-footer-bottom a:hover {
        color: #ffffff;
    }

    @media screen and (max-width: 1180px) {
        .sq-footer-services {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media screen and (max-width: 900px) {
        .sq-footer-brandbar {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .sq-footer-services {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media screen and (max-width: 620px) {
        .sq-footer-container {
            padding: 0 16px;
        }

        .sq-footer-top {
            padding: 40px 0 24px;
        }

        .sq-footer-services {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .sq-footer-group {
            padding: 18px 16px;
        }

        .sq-footer-brandbar {
            margin-top: 16px;
            padding: 18px 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .sq-footer-brand h2,
        .sq-footer-brand p {
            text-align: center;
        }

        .sq-footer-brand h2 {
            font-size: 22px;
        }

        .sq-footer-social {
            justify-content: center;
            width: 100%;
            margin-top: 10px;
        }

        .sq-footer-bottom {
            padding-bottom: 18px !important;
        }
    }
  
  .sq-footer-brand{
  text-align:center!important;
  }
</style>  

<!-- Hide Footer on /privacy-policy and /pricing page -->

<script>
document.addEventListener("DOMContentLoaded", function () {
    var currentPath = window.location.pathname.replace(/\/+$/, "");

    var pagesWithoutFooter = [
        "/privacy-policy",
        "/pricing",
  		"/terms-of-service",
  		"/terms-and-conditions",
        "/withdraw-funds"
    ];

    if (pagesWithoutFooter.includes(currentPath)) {
        var footer = document.getElementById("sq-service-footer");

        if (footer) {
            footer.style.display = "none";
        }
    }
});
</script>

