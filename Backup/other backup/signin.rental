        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .sq-footer-links a
    {
        position: relative;
        display: inline-block;
        width: fit-content;
        max-width: 100%;
        padding-left: 0;
        color: #b9c6d2;
        font-size: 13px;
        line-height: 1.55;
        transition:
            color 0.2s ease,
            transform 0.2s ease;
    }

    .sq-footer-links a::before
    {
        position: absolute;
        top: 0.72em;
        left: 0;
        width: 0;
        height: 1px;
        background: #8dccfa;
        content: "";
        opacity: 0;
        transition:
            width 0.2s ease,
            opacity 0.2s ease;
    }

    .sq-footer-links a:hover,
    .sq-footer-links a:focus
    {
        padding-left: 13px;
        color: #ffffff;
        transform: translateX(2px);
    }

    .sq-footer-links a:hover::before,
    .sq-footer-links a:focus::before
    {
        width: 7px;
        opacity: 1;
    }

    .sq-footer-brandbar
    {
        display: grid;
        align-items: center;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 24px;
        margin-top: 22px;
        padding: 24px 0;
        border-top: 1px solid rgba(151, 201, 238, 0.11);
