        .sq-footer-brandbar
        {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .sq-footer-services
        {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sq-footer-cta
        {
            width: fit-content;
        }
    }

    @media screen and (max-width: 620px)
