        background: linear-gradient(
            145deg,
            rgba(84, 143, 191, 0.10),
            rgba(255, 255, 255, 0.026)
        );
        transform: translateY(-4px);
    }

    .sq-footer-group h3
    {
        margin: 0 0 16px;
        background: linear-gradient(
            90deg,
            #8dccfa,
            #d9f0ff
        );
        color: #a9d8fa;
        font-size: 17px;
        line-height: 1.35;
        font-weight: 780;
        letter-spacing: -0.2px;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .sq-footer-links
