<style>
    .sq-footer,
    .sq-footer *
    {
        box-sizing: border-box;
    }

    .sq-footer
    {
        position: relative;
        overflow: hidden;
        width: 100%;
        margin-top: 0;
        background: transparent;
        color: #f4f8fc;
        font-family: "Helvetica Neue", Arial, sans-serif;
    }

    .sq-footer::before
    {
        position: absolute;
        right: -180px;
        bottom: 90px;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(76, 157, 216, 0.12),
            transparent 68%
        );
        content: "";
        pointer-events: none;
    }

    .sq-footer a
    {
        text-decoration: none;
    }

    .sq-footer-container
    {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1480px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .sq-footer-top
    {
        padding: 72px 0 38px;
        border-top: 1px solid rgba(151, 201, 238, 0.12);
    }

    .sq-footer-intro
    {
        display: grid;
        align-items: end;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 30px;
        margin-bottom: 34px;
    }

    .sq-footer-eyebrow
    {
        margin-bottom: 10px;
        color: #86c9ff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.45px;
        text-transform: uppercase;
    }

    .sq-footer-intro h2
    {
        max-width: 720px;
        margin: 0 0 12px;
        color: #f8fbff;
        font-size: 34px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

    .sq-footer-intro p
    {
        max-width: 760px;
        margin: 0;
        color: #aebdca;
        font-size: 15px;
        line-height: 1.75;
    }

    .sq-footer-cta
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 20px;
        border: 1px solid rgba(196, 231, 255, 0.78);
        border-radius: 10px;
        background: linear-gradient(
            135deg,
            #d8efff,
            #8cc9f6
        );
        box-shadow: 0 12px 28px rgba(48, 132, 194, 0.22);
        color: #102233;
        font-size: 14px;
        font-weight: 800;
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background 0.25s ease;
    }

    .sq-footer-cta:hover,
    .sq-footer-cta:focus
    {
        background: linear-gradient(
            135deg,
            #e8f6ff,
            #9bd4fa
        );
        box-shadow: 0 16px 34px rgba(48, 132, 194, 0.30);
        color: #081622;
        transform: translateY(-3px);
    }

    .sq-footer-services
    {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .sq-footer-group
    {
        min-height: 100%;
        padding: 23px 21px;
        border: 1px solid rgba(151, 201, 238, 0.14);
        border-radius: 14px;
        background: linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.048),
            rgba(255, 255, 255, 0.018)
        );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.03),
            0 10px 24px rgba(7, 19, 30, 0.08);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            background 0.25s ease;
    }

    .sq-footer-group:hover
