        align-items: center;
        gap: 10px;
    }

    .sq-footer-social a
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 1px solid rgba(151, 201, 238, 0.18);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
        color: #c9e8ff;
        font-size: 16px;
        transition:
            transform 0.22s ease,
            border-color 0.22s ease,
            background 0.22s ease,
            color 0.22s ease;
    }

    .sq-footer-social a:hover,
    .sq-footer-social a:focus
    {
        border-color: rgba(132, 199, 251, 0.42);
        background: rgba(84, 143, 191, 0.13);
        color: #ffffff;
        transform: translateY(-3px);
    }

    .sq-footer-bottom
    {
        position: relative;
        z-index: 2;
        padding: 17px 15px;
        border-top: 1px solid rgba(151, 201, 238, 0.10);
        background: rgba(10, 22, 34, 0.22);
        text-align: center;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .sq-footer-bottom p
    {
        margin: 0;
        color: #91a4b5;
        font-size: 13px;
        line-height: 1.7;
    }

    .sq-footer-bottom a
    {
        color: #d9efff;
        font-weight: 700;
    }

    .sq-footer-bottom a:hover
    {
        color: #ffffff;
    }

    @media screen and (max-width: 1180px)
    {
