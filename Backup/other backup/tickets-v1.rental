<style>
    /* ==========================================================================
       GLOBAL CONTAINER & HORIZONTAL OVERFLOW PREVENTION
       ========================================================================== */
    html, body {
        overflow-x: hidden !important;
        max-width: 100vw !important;
        scroll-behavior: smooth !important;
    }

    #index .col-md-12 {
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .container-fluid-spacious,
    .container-fluid-spacious * {
        box-sizing: border-box !important;
    }

    .container-fluid-spacious {
        position: relative;
        isolation: isolate;
        width: 100% !important;
        max-width: 1280px !important;
        margin: 0 auto !important;
        padding: 24px 20px 80px !important;
        overflow-x: hidden !important;
        color: #f4f8fc;
        font-family: "Helvetica Neue", Arial, sans-serif;
    }

    /* Balanced 80% Form Width */
    .container-fluid-spacious .col-md-8.col-md-offset-2 {
        width: 100% !important;
        max-width: 960px !important;
        margin: 0 auto !important;
        float: none !important;
        padding: 0 10px !important;
    }

    /* Ambient Background Glow */
    .container-fluid-spacious::before {
        position: absolute;
        z-index: -1;
        top: 15%;
        right: -140px;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(76, 157, 216, 0.13), transparent 70%);
        content: "";
        pointer-events: none;
    }

    /* ==========================================================================
       AURORA GLASS CARD & WELL STYLING
       ========================================================================== */
    .container-fluid-spacious .well,
    .container-fluid-spacious .well-float {
        position: relative;
        overflow: hidden !important;
        border: 1px solid rgba(143, 203, 249, 0.22) !important;
        border-radius: 16px !important;
        background: linear-gradient(
            145deg,
            rgba(25, 49, 68, 0.90),
            rgba(16, 34, 50, 0.85)
        ) !important;
        box-shadow: 0 24px 50px rgba(5, 16, 27, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.045) !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        padding: 28px 32px !important;
        margin-bottom: 24px !important;
        color: #f4f8fc !important;
        width: 100% !important;
    }

    .container-fluid-spacious .well:empty {
        display: none !important;
    }

    .container-fluid-spacious .table-responsive {
        border: none !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
    }

    /* ==========================================================================
       NAVIGATION TABS & SEARCH BAR
       ========================================================================== */
    .container-fluid-spacious nav {
        margin-bottom: 22px !important;
        width: 100% !important;
    }

    .container-fluid-spacious .nav-pills {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 8px !important;
        margin: 0 !important;
        padding: 0 !important;
        list-style: none !important;
    }

    .container-fluid-spacious .nav-pills > li > a,
    .container-fluid-spacious .nav-pills > li.nav-item > a.nav-link {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 9px 20px !important;
        border: 1px solid rgba(151, 201, 238, 0.16) !important;
        border-radius: 10px !important;
        background: rgba(255, 255, 255, 0.035) !important;
        color: #b7c8d6 !important;
        font-size: 13.5px !important;
        font-weight: 700 !important;
        text-decoration: none !important;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    background 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    .container-fluid-spacious .nav-pills > li > a:hover,
    .container-fluid-spacious .nav-pills > li.nav-item > a.nav-link:hover {
        background: rgba(141, 204, 250, 0.12) !important;
        border-color: rgba(141, 204, 250, 0.4) !important;
        color: #ffffff !important;
        transform: translateY(-2px) !important;
    }

    .container-fluid-spacious .nav-pills > li.active > a,
    .container-fluid-spacious .nav-pills > li.active > a:hover,
    .container-fluid-spacious .nav-pills > li.active > a:focus,
    .container-fluid-spacious .nav-pills > li.nav-item.active > a.nav-link {
        background: linear-gradient(135deg, #d8efff, #8cc9f6) !important;
        border-color: rgba(196, 231, 255, 0.8) !important;
        color: #102233 !important;
        box-shadow: 0 8px 20px rgba(48, 132, 194, 0.25) !important;
    }

    /* Mobile Custom Dropdown */
    .container-fluid-spacious select.custom-select {
        display: none;
        width: 100% !important;
        height: 48px !important;
        padding: 0 16px !important;
        border: 1px solid rgba(151, 199, 235, 0.24) !important;
        border-radius: 10px !important;
        background-color: #122434 !important;
        color: #f4f8fc !important;
        font-size: 14px !important;
        outline: none !important;
        cursor: pointer !important;
        appearance: none !important;
        -webkit-appearance: none !important;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238dccfa' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right 16px center !important;
        background-size: 15px !important;
        padding-right: 42px !important;
        margin-bottom: 16px !important;
    }

    .container-fluid-spacious select.custom-select option {
        background-color: #122434 !important;
        color: #f4f8fc !important;
        padding: 10px 14px !important;
    }

    /* Search Bar Row */
    #history-search {
        margin-bottom: 20px !important;
    }

    #history-search .input-group {
        display: flex !important;
        width: 100% !important;
    }

    #history-search .form-control {
        height: 46px !important;
        min-height: 46px !important;
        padding: 0 16px !important;
        border: 1px solid rgba(151, 199, 235, 0.24) !important;
        border-right: none !important;
        border-radius: 10px 0 0 10px !important;
        background: rgba(255, 255, 255, 0.045) !important;
        color: #f4f8fc !important;
        font-size: 14px !important;
        outline: none !important;
        box-shadow: none !important;
        transition: border-color 0.2s ease, background 0.2s ease !important;
    }

    #history-search .form-control:focus {
        border-color: rgba(134, 201, 255, 0.6) !important;
        background: rgba(255, 255, 255, 0.07) !important;
    }

    #history-search .form-control::placeholder {
        color: #7d93a6 !important;
    }

    #history-search .input-group-btn {
        display: inline-flex !important;
    }

    #history-search .btn {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        height: 46px !important;
        min-width: 48px !important;
        padding: 0 16px !important;
        border: 1px solid rgba(151, 199, 235, 0.24) !important;
        border-left: none !important;
        border-radius: 0 10px 10px 0 !important;
        background: rgba(69, 127, 173, 0.25) !important;
        color: #8dccfa !important;
        cursor: pointer !important;
        transition: background 0.2s ease, color 0.2s ease !important;
    }

    #history-search .btn:hover {
        background: rgba(141, 204, 250, 0.35) !important;
        color: #ffffff !important;
    }

    /* ==========================================================================
       FORM ELEMENTS (NEW TICKET)
       ========================================================================== */
    .container-fluid-spacious .form-group {
        margin-bottom: 22px !important;
        width: 100% !important;
    }

    .container-fluid-spacious .control-label,
    .container-fluid-spacious label {
        display: block !important;
        margin-bottom: 8px !important;
        color: #e8f3fb !important;
        font-size: 14px !important;
        font-weight: 750 !important;
        letter-spacing: 0.2px;
    }

    .container-fluid-spacious .form-control {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        height: 52px !important;
        min-height: 52px !important;
        padding: 0 16px !important;
        border: 1px solid rgba(151, 199, 235, 0.24) !important;
        border-radius: 10px !important;
        outline: none !important;
        background-color: rgba(255, 255, 255, 0.045) !important;
        box-shadow: none !important;
        color: #f4f8fc !important;
        font-family: inherit !important;
        font-size: 14.5px !important;
        line-height: 1.4 !important;
        transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.24s cubic-bezier(0.16, 1, 0.3, 1),
                    background 0.24s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.24s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    .container-fluid-spacious textarea.form-control {
        height: auto !important;
        min-height: 130px !important;
        padding: 14px 16px !important;
        resize: vertical !important;
    }

    .container-fluid-spacious .form-control:hover {
        border-color: rgba(151, 199, 235, 0.42) !important;
    }

    .container-fluid-spacious .form-control:focus {
        border-color: rgba(134, 201, 255, 0.65) !important;
        background-color: rgba(255, 255, 255, 0.065) !important;
        box-shadow: 0 0 0 4px rgba(93, 174, 232, 0.12) !important;
    }

    /* Submit Button */
    .container-fluid-spacious .btn-primary {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        min-height: 52px !important;
        padding: 0 24px !important;
        border: 1px solid rgba(196, 231, 255, 0.8) !important;
        border-radius: 10px !important;
        background: linear-gradient(135deg, #d8efff, #8cc9f6) !important;
        box-shadow: 0 10px 24px rgba(48, 132, 194, 0.25) !important;
        color: #102233 !important;
        font-family: inherit !important;
        font-size: 15px !important;
        font-weight: 800 !important;
        letter-spacing: 0.3px !important;
        cursor: pointer !important;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    background 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    color 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    .container-fluid-spacious .btn-primary:hover,
    .container-fluid-spacious .btn-primary:focus {
        border-color: rgba(222, 242, 255, 0.95) !important;
        background: linear-gradient(135deg, #e8f6ff, #9bd4fa) !important;
        box-shadow: 0 16px 36px rgba(48, 132, 194, 0.38) !important;
        color: #081622 !important;
        transform: translateY(-3px) !important;
    }

    /* Error Alert */
    .container-fluid-spacious .alert {
        margin-bottom: 20px !important;
        padding: 14px 18px !important;
        border: 1px solid rgba(255, 151, 159, 0.35) !important;
        border-radius: 12px !important;
        background: rgba(189, 60, 71, 0.16) !important;
        color: #ffd6d9 !important;
        font-size: 13.5px !important;
        line-height: 1.6 !important;
    }

    /* ==========================================================================
       TICKETS TABLE STYLING
       ========================================================================== */
    .container-fluid-spacious .table {
        width: 100% !important;
        margin-bottom: 0 !important;
        border-collapse: collapse !important;
        color: #c4d3e0 !important;
        font-size: 13.5px !important;
    }

    .container-fluid-spacious .table thead th {
        padding: 15px 16px !important;
        border-bottom: 1px solid rgba(151, 201, 238, 0.16) !important;
        background: rgba(20, 42, 60, 0.6) !important;
        color: #e5f3ff !important;
        font-size: 12.5px !important;
        font-weight: 800 !important;
        letter-spacing: 0.5px !important;
        text-transform: uppercase !important;
        vertical-align: middle !important;
        white-space: nowrap !important;
    }

    .container-fluid-spacious .table tbody tr {
        border-bottom: 1px solid rgba(151, 201, 238, 0.08) !important;
        transition: background 0.2s ease !important;
    }

    .container-fluid-spacious .table tbody tr:hover {
        background: rgba(141, 204, 250, 0.05) !important;
    }

    .container-fluid-spacious .table tbody tr:last-child {
        border-bottom: none !important;
    }

    .container-fluid-spacious .table tbody td {
        padding: 14px 16px !important;
        vertical-align: middle !important;
        border-top: none !important;
        line-height: 1.55 !important;
    }

    .container-fluid-spacious .table a {
        color: #8dccfa !important;
        font-weight: 700 !important;
        text-decoration: none !important;
        transition: color 0.2s ease !important;
    }

    .container-fluid-spacious .table a:hover {
        color: #ffffff !important;
    }

    /* Status Labels */
    .container-fluid-spacious .table .label {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    /* ==========================================================================
       PAGINATION
       ========================================================================== */
    .container-fluid-spacious .pagination {
        display: flex !important;
        justify-content: center !important;
        flex-wrap: wrap !important;
        gap: 6px !important;
        margin: 24px 0 0 !important;
        padding: 0 !important;
        list-style: none !important;
    }

    .container-fluid-spacious .pagination > li > a,
    .container-fluid-spacious .pagination > li > span {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        min-width: 38px !important;
        height: 38px !important;
        padding: 0 12px !important;
        border: 1px solid rgba(151, 201, 238, 0.16) !important;
        border-radius: 8px !important;
        background: rgba(255, 255, 255, 0.035) !important;
        color: #b7c8d6 !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        text-decoration: none !important;
        transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease !important;
    }

    .container-fluid-spacious .pagination > li > a:hover {
        background: rgba(141, 204, 250, 0.15) !important;
        border-color: rgba(141, 204, 250, 0.4) !important;
        color: #ffffff !important;
        transform: translateY(-2px) !important;
    }

    .container-fluid-spacious .pagination > li.active > a,
    .container-fluid-spacious .pagination > li.active > span,
    .container-fluid-spacious .pagination > li.active > a:hover,
    .container-fluid-spacious .pagination > li.active > span:hover {
        background: linear-gradient(135deg, #d8efff, #8cc9f6) !important;
        border-color: rgba(196, 231, 255, 0.8) !important;
        color: #102233 !important;
        box-shadow: 0 6px 16px rgba(48, 132, 194, 0.28) !important;
    }

    .container-fluid-spacious .pagination > .disabled > span,
    .container-fluid-spacious .pagination > .disabled > a {
        opacity: 0.4 !important;
        cursor: not-allowed !important;
    }

    /* ==========================================================================
       RESPONSIVE ADJUSTMENTS
       ========================================================================== */
    @media screen and (max-width: 991px) {
        .container-fluid-spacious {
            padding: 18px 16px 60px !important;
        }

        .container-fluid-spacious .col-md-4.col-md-offset-8 {
            margin-left: 0 !important;
            width: 100% !important;
        }
    }

    @media screen and (max-width: 767px) {
        .container-fluid-spacious .nav-pills {
            display: none !important;
        }

        .container-fluid-spacious select.custom-select {
            display: block !important;
        }

        .container-fluid-spacious .well,
        .container-fluid-spacious .well-float {
            padding: 20px 16px !important;
            border-radius: 14px !important;
        }

        .container-fluid-spacious .table thead th,
        .container-fluid-spacious .table tbody td {
            padding: 12px 10px !important;
            font-size: 13px !important;
        }
    }
</style>

<div class="container-fluid container-fluid-spacious">
    <div class="col-md-8 col-md-offset-2">
        <div class="row">
            <div class="col-md-12">
             
                [tickets.content.top]
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                [error_message]
                <nav>
                    <select name="category" id="page_Category" class="custom-select w-full" onchange="$('#pills-tab a[href=\'' + (this.value == '2' ? '#info' : '#new-ticket') + '\']').tab('show');">
                        <option value="0">[tickets.tab.add_new]</option>
                        <option value="2">[tickets.tab.updates]</option>
                    </select>
                    <ul class="nav nav-pills" id="pills-tab" role="tablist">
                        <li class="nav-item active">
                            <a class="nav-link" id="pills-home-tab" data-toggle="pill" href="#new-ticket" role="tab" aria-controls="pills-home" aria-selected="true">[tickets.tab.add_new]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="pills-info-tab" data-toggle="pill" href="#info" role="tab" aria-controls="pills-info" aria-selected="false">[tickets.tab.updates]</a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="col-md-12">
                <!-- Tab Content Starts here -->
                <div class="tab-content" id="pills-tabContent">
                    <!-- New Ticket Tab -->
                    <div class="tab-pane fade active in" id="new-ticket" role="tabpanel" aria-labelledby="pills-home-tab">
                        <div id="main-page" class="well well-float table-responsive">
                            <!-- Form Started -->
                            <form method="post" action="" id="ticketsend" onSubmit="form_submit()">
                                <div class="form-group">
                                    <label for="subjet" class="control-label">[tickets.form.subject]</label>
                                    <input type="hidden" name="add_ticket" value="add_ticket" />
                                    <input class="form-control" name="subject" id="subjet" type="text">
                                </div>
                                <div class="form-group">
                                    <label for="text" class="control-label">[tickets.form.message]</label>
                                    <textarea id="text" name="message" rows="5" class="form-control"></textarea>
                                </div>
                                [panel.csrf_protection]
                                <input type="hidden" name="add_ticket" value="add_ticket" />
                                <button type="submit" class="btn btn-primary">[tickets.form.submit_button]</button>
                            </form>
                        </div>
                        
                        <div class="row">	
                            <div class="col-md-4 col-md-offset-8">
                                <div class="nav-pills">
                                    <form action="" method="get" id="history-search">
                                        <div class="input-group">
                                            <input type="text" class="form-control" value="[tickets.form.search.value]" name="search" placeholder="Search tickets">
                                            <span class="input-group-btn">
                                                <button type="submit" class="btn btn-default" aria-label="Search"><i class="fas fa-search" aria-hidden="true"></i></button>
                                            </span>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        
                        <div class="well well-float table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th width="5%">#</th>
                                        <th>[tickets.table.subject]</th>
                                        <th width="13%">[tickets.table.status]</th>
                                        <th width="30%">[tickets.table.last_update]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    [template.tickets.table.items]
                                </tbody>
                            </table>
                            <nav class="nav-forced-centered">
                                <ul id="yw0" class="pagination m-b-0">
                                    [template.pages.pagination.items]
                                </ul>
                            </nav>
                        </div>
                    </div>
                    
                    <!-- Updates Tab -->
                    <div class="tab-pane fade" id="info" role="tabpanel" aria-labelledby="pills-info-tab">
                        <div id="main-page" class="well well-float table-responsive">
                            [tickets.content.bottom]
                        </div>
                    </div>
                </div>		
            </div>
        </div>
    </div>
</div>