<!-- SMM Quality Perfect Panel Signup Page | Aurora Glass -->
<style>
    .sq-signup-page,
    .sq-signup-page *
    {
        box-sizing: border-box;
    }

    .sq-signup-page
    {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        width: 100%;
        min-height: calc(100vh - 90px);
        padding: 76px 0 72px;
        background: transparent;
        color: #f4f8fc;
        font-family: "Helvetica Neue", Arial, sans-serif;
    }

    .sq-signup-page::before
    {
        position: absolute;
        z-index: -1;
        top: 48%;
        right: -190px;
        width: 680px;
        height: 680px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(76, 157, 216, 0.15),
            rgba(76, 157, 216, 0.05) 38%,
            transparent 70%
        );
        content: "";
        pointer-events: none;
        transform: translateY(-50%);
    }

    .sq-signup-page a
    {
        text-decoration: none;
    }

    .sq-signup-container
    {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .sq-signup-layout
    {
        display: grid;
        align-items: center;
        grid-template-columns: minmax(0, 0.95fr) minmax(470px, 0.82fr);
        gap: 72px;
    }

    .sq-signup-copy
    {
        position: relative;
        z-index: 2;
        max-width: 610px;
    }

    .sq-signup-eyebrow
    {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 24px;
        padding: 8px 14px;
        border: 1px solid rgba(126, 194, 247, 0.28);
        border-radius: 999px;
        background: rgba(69, 127, 173, 0.17);
        color: #cbe7ff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.15px;
        text-transform: uppercase;
    }

    .sq-signup-status
    {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #8dccfa;
        box-shadow: 0 0 0 5px rgba(141, 204, 250, 0.12);
    }

    .sq-signup-copy h1
    {
        max-width: 610px;
        margin: 0 0 21px;
        color: #f8fbff;
        font-size: clamp(43px, 5vw, 64px);
        line-height: 1.06;
        font-weight: 820;
        letter-spacing: -2.2px;
    }

    .sq-signup-highlight
    {
        background: linear-gradient(
            90deg,
            #8dccfa,
            #d9f0ff
        );
        color: #a9d8fa;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .sq-signup-description
    {
        max-width: 570px;
        margin: 0;
        color: #b8c6d3;
        font-size: 17px;
        line-height: 1.78;
    }

    .sq-signup-trust
    {
        display: grid;
        gap: 13px;
        margin-top: 30px;
    }

    .sq-signup-trust-item
    {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #d3dde6;
        font-size: 14px;
        line-height: 1.5;
    }

    .sq-signup-trust-icon
    {
        display: inline-flex;
        flex: 0 0 24px;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border: 1px solid rgba(139, 202, 250, 0.20);
        border-radius: 50%;
        background: rgba(63, 124, 171, 0.22);
        color: #cfeaff;
        font-size: 12px;
        font-weight: 900;
    }

    .sq-signup-mini-stats
    {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-top: 34px;
    }

    .sq-signup-mini-stat
    {
        padding: 16px 15px;
        border: 1px solid rgba(151, 201, 238, 0.13);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.028);
        backdrop-filter: blur(9px);
        -webkit-backdrop-filter: blur(9px);
    }

    .sq-signup-mini-stat strong
    {
        display: block;
        margin-bottom: 5px;
        background: linear-gradient(
            90deg,
            #8dccfa,
            #d9f0ff
        );
        color: #a9d8fa;
        font-size: 20px;
        line-height: 1.2;
        font-weight: 820;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .sq-signup-mini-stat span
    {
        color: #92a7b9;
        font-size: 11px;
        line-height: 1.45;
    }

    .sq-signup-card-wrap
    {
        position: relative;
        z-index: 3;
    }

    .sq-signup-card
    {
        position: relative;
        overflow: hidden;
        width: 100%;
        padding: 38px;
        border: 1px solid rgba(143, 203, 249, 0.24);
        border-radius: 18px;
        background: linear-gradient(
            145deg,
            rgba(25, 49, 68, 0.88),
            rgba(16, 34, 50, 0.82)
        );
        box-shadow:
            0 30px 65px rgba(5, 16, 27, 0.24),
            inset 0 1px 0 rgba(255, 255, 255, 0.045);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .sq-signup-card::before
    {
        position: absolute;
        top: -180px;
        right: -150px;
        width: 360px;
        height: 360px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(94, 174, 232, 0.13),
            transparent 69%
        );
        content: "";
        pointer-events: none;
    }

    .sq-signup-card-content
    {
        position: relative;
        z-index: 2;
    }

    .sq-signup-card-head
    {
        margin-bottom: 26px;
    }

    .sq-signup-card h2
    {
        margin: 0 0 8px;
        color: #f8fbff;
        font-size: 31px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.65px;
    }

    .sq-signup-card-subtitle
    {
        margin: 0;
        color: #aab9c8;
        font-size: 14px;
        line-height: 1.65;
    }

    .sq-signup-card form
    {
        margin: 0;
    }

    .sq-signup-page .sq-signup-fields
    {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .sq-signup-page .form-group
    {
        min-width: 0;
        margin: 0;
    }

    .sq-signup-page .form-group.sq-signup-full
    {
        grid-column: 1 / -1;
    }

    .sq-signup-page .control-label
    {
        display: block;
        margin: 0 0 8px;
        color: #e8f3fb;
        font-size: 13px;
        line-height: 1.45;
        font-weight: 750;
    }

    .sq-signup-page .form-control
    {
        display: block;
        width: 100%;
        height: 56px;
        min-height: 56px;
        padding: 0 16px;
        border: 1px solid rgba(151, 199, 235, 0.23);
        border-radius: 11px;
        outline: none;
        background: rgba(255, 255, 255, 0.045);
        box-shadow: none;
        color: #f4f8fc;
        font-family: inherit;
        font-size: 15px;
        line-height: 1.4;
        appearance: none;
        -webkit-appearance: none;
        transition:
            border-color 0.22s ease,
            background 0.22s ease,
            box-shadow 0.22s ease;
    }

    .sq-signup-page .form-control::placeholder
    {
        color: #8296a8;
        opacity: 1;
    }

    .sq-signup-page .form-control:hover
    {
        border-color: rgba(151, 199, 235, 0.36);
    }

    .sq-signup-page .form-control:focus
    {
        border-color: rgba(134, 201, 255, 0.62);
        background: rgba(255, 255, 255, 0.063);
        box-shadow: 0 0 0 4px rgba(93, 174, 232, 0.09);
    }

    .sq-signup-page input:-webkit-autofill,
    .sq-signup-page input:-webkit-autofill:hover,
    .sq-signup-page input:-webkit-autofill:focus
    {
        border: 1px solid rgba(134, 201, 255, 0.45);
        -webkit-box-shadow: 0 0 0 1000px #1b3448 inset;
        -webkit-text-fill-color: #f4f8fc;
        caret-color: #f4f8fc;
        transition: background-color 9999s ease-out 0s;
    }

    .sq-signup-page .help-block
    {
        min-height: 0;
        margin: 6px 0 0;
        color: #ffb2b7;
        font-size: 12px;
        line-height: 1.45;
    }

    .sq-signup-page .alert
    {
        margin: 0 0 18px;
        padding: 13px 15px;
        border: 1px solid rgba(255, 151, 159, 0.30);
        border-radius: 10px;
        background: rgba(189, 60, 71, 0.14);
        box-shadow: none;
        color: #ffd6d9;
        font-size: 13px;
        line-height: 1.6;
    }

    .sq-signup-page .alert-success
    {
        border-color: rgba(112, 226, 170, 0.25);
        background: rgba(54, 154, 111, 0.14);
        color: #cbf5e1;
    }

    .sq-signup-page .alert a
    {
        color: inherit;
        font-weight: 750;
        text-decoration: underline;
    }

    .sq-signup-terms
    {
        grid-column: 1 / -1;
        margin-top: 2px;
    }

    .sq-signup-page .checkbox
    {
        margin: 0;
    }

    .sq-signup-page .checkbox label
    {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin: 0;
        padding: 0;
        color: #b9c6d2;
        font-size: 13px;
        line-height: 1.6;
        font-weight: 500;
        cursor: pointer;
    }

    .sq-signup-page .checkbox input
    {
        flex: 0 0 17px;
        width: 17px;
        height: 17px;
        margin: 2px 0 0;
        accent-color: #8dccfa;
        cursor: pointer;
    }

    .sq-signup-page .checkbox a
    {
        color: #d4ecff;
        font-weight: 750;
    }

    .sq-signup-page .checkbox a:hover,
    .sq-signup-page .checkbox a:focus
    {
        color: #ffffff;
    }

    .sq-signup-recaptcha
    {
        grid-column: 1 / -1;
        overflow: hidden;
        margin-top: 2px;
    }

    .sq-signup-recaptcha .g-recaptcha
    {
        transform-origin: left top;
    }

    .sq-signup-submit
    {
        display: inline-flex;
        grid-column: 1 / -1;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 54px;
        margin-top: 2px;
        padding: 0 22px;
        border: 1px solid rgba(196, 231, 255, 0.80);
        border-radius: 10px;
        outline: none;
        background: linear-gradient(
            135deg,
            #d8efff,
            #8cc9f6
        );
        box-shadow: 0 13px 30px rgba(48, 132, 194, 0.25);
        color: #102233;
        font-family: inherit;
        font-size: 15px;
        line-height: 1.2;
        font-weight: 800;
        cursor: pointer;
        transition:
            transform 0.24s ease,
            background 0.24s ease,
            box-shadow 0.24s ease;
    }

    .sq-signup-submit:hover,
    .sq-signup-submit:focus
    {
        border-color: rgba(222, 242, 255, 0.95);
        background: linear-gradient(
            135deg,
            #e8f6ff,
            #9bd4fa
        );
        box-shadow: 0 17px 36px rgba(48, 132, 194, 0.33);
        color: #081622;
        transform: translateY(-2px);
    }

    .sq-signup-submit:active
    {
        transform: translateY(0);
    }

    .sq-signup-security
    {
        display: flex;
        grid-column: 1 / -1;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: -2px;
        color: #8298aa;
        font-size: 11px;
        line-height: 1.5;
        text-align: center;
    }

    .sq-signup-login
    {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 18px;
        color: #9fb0bf;
        font-size: 13px;
        line-height: 1.55;
        text-align: center;
    }

    .sq-signup-login a
    {
        color: #d4ecff;
        font-weight: 800;
        transition: color 0.2s ease;
    }

    .sq-signup-login a:hover,
    .sq-signup-login a:focus
    {
        color: #ffffff;
    }

    @media screen and (max-width: 991px)
    {
        .sq-signup-page
        {
            padding: 66px 0 64px;
        }

        .sq-signup-layout
        {
            grid-template-columns: 1fr;
            gap: 46px;
        }

        .sq-signup-copy
        {
            max-width: 760px;
            margin: 0 auto;
            text-align: center;
        }

        .sq-signup-copy h1,
        .sq-signup-description
        {
            margin-right: auto;
            margin-left: auto;
        }

        .sq-signup-trust
        {
            max-width: 560px;
            margin-right: auto;
            margin-left: auto;
            text-align: left;
        }

        .sq-signup-mini-stats
        {
            max-width: 620px;
            margin-right: auto;
            margin-left: auto;
            text-align: left;
        }

        .sq-signup-card-wrap
        {
            width: 100%;
            max-width: 650px;
            margin: 0 auto;
        }
    }

    @media screen and (max-width: 620px)
    {
        .sq-signup-page
        {
            min-height: auto;
            padding: 50px 0 58px;
        }

        .sq-signup-page::before
        {
            top: 34%;
            right: -330px;
            width: 600px;
            height: 600px;
        }

        .sq-signup-container
        {
            padding: 0 15px;
        }

        .sq-signup-layout
        {
            gap: 0;
        }

        .sq-signup-copy
        {
            display: none;
        }

        .sq-signup-card-wrap
        {
            max-width: 100%;
        }

        .sq-signup-card
        {
            padding: 27px 20px;
            border-radius: 15px;
        }

        .sq-signup-card h2
        {
            font-size: 27px;
        }

        .sq-signup-page .sq-signup-fields
        {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .sq-signup-page .form-group,
        .sq-signup-terms,
        .sq-signup-recaptcha,
        .sq-signup-submit,
        .sq-signup-security
        {
            grid-column: 1;
        }

        .sq-signup-page .form-control
        {
            height: 54px;
            min-height: 54px;
        }

        .sq-signup-recaptcha
        {
            max-width: 100%;
        }

        .sq-signup-recaptcha .g-recaptcha
        {
            transform: scale(0.88);
        }
    }

    @media screen and (max-width: 380px)
    {
        .sq-signup-recaptcha .g-recaptcha
        {
            transform: scale(0.79);
        }
    }


.sq-signup-layout
{
    align-items: start;
}

.sq-signup-copy
{
    padding-top: 38px;
}


</style>

<div class="sq-signup-page">

    <div class="sq-signup-container">

        <div class="sq-signup-layout">

            <section class="sq-signup-copy">

                <div class="sq-signup-eyebrow">

                    <span class="sq-signup-status"></span>

                    Instant account registration

                </div>

                <h1>

                    Create Your

                    <span class="sq-signup-highlight">

                        Free Account

                    </span>

                </h1>

                <p class="sq-signup-description">

                    Join SMM Quality to access live pricing, manage funds,
                    place orders, track delivery, and reach real human support
                    from one secure dashboard.

                </p>

                <!-- <div class="sq-signup-trust">

                    <div class="sq-signup-trust-item">

                        <span class="sq-signup-trust-icon">✓</span>

                        <span>Browse live pricing and the complete service catalogue</span>

                    </div>

                    <div class="sq-signup-trust-item">

                        <span class="sq-signup-trust-icon">✓</span>

                        <span>Manage your wallet, orders, and account activity</span>

                    </div>

                    <div class="sq-signup-trust-item">

                        <span class="sq-signup-trust-icon">✓</span>

                        <span>Get 24x7 assistance from a 12 person support team</span>

                    </div>

                </div> -->

                <div class="sq-signup-mini-stats">

                    <div class="sq-signup-mini-stat">

                        <strong>15,00,000+</strong>

                        <span>Orders delivered</span>

                    </div>

                    <div class="sq-signup-mini-stat">

                        <strong>120,000+</strong>

                        <span>Registered Users</span>

                    </div>

                    <div class="sq-signup-mini-stat">

                        <strong>9+</strong>

                        <span>Years Experience</span>

                    </div>

                </div>

            </section>

            <section class="sq-signup-card-wrap">

                <div class="sq-signup-card">

                    <div class="sq-signup-card-content">

                        <div class="sq-signup-card-head">

                            <h2>Create Account</h2>

                            <p class="sq-signup-card-subtitle">

                                Enter your details below to access your SMM Quality dashboard.

                            </p>

                        </div>

                        [error_message]

                        <form
                            id="yw0"
                            action=""
                            method="post"
                            onsubmit="return page_load(this);"
                        >

                            <div class="sq-signup-fields">

                                <div
                                    class="form-group sq-signup-full"
                                    style="[signup.username-field]"
                                >

                                    <label class="control-label" for="full_name">

                                        [signup.form.full_name]

                                    </label>

                                    <input
                                        class="form-control"
                                        name="full_name"
                                        id="full_name"
                                        type="text"
                                        autocomplete="name"
                                    >

                                    <p class="help-block help-block-error"></p>

                                </div>

                                <div class="form-group">

                                    <label class="control-label" for="username">

                                        [signup.form.username]

                                    </label>

                                    <input
                                        class="form-control"
                                        name="username"
                                        id="username"
                                        required
                                        type="text"
                                        autocomplete="username"
                                    >

                                    <p class="help-block help-block-error"></p>

                                </div>

                                <div class="form-group">

                                    <label class="control-label" for="email">

                                        [signup.form.email]

                                    </label>

                                    <input
                                        class="form-control"
                                        name="email"
                                        id="email"
                                        required
                                        type="email"
                                        autocomplete="email"
                                    >

                                    <p class="help-block help-block-error"></p>

                                </div>

                                <div
                                    class="form-group sq-signup-full"
                                    style="[signup.skype-field]"
                                >

                                    <label class="control-label" for="skype">

                                        [signup.form.skype]

                                    </label>

                                    <input
                                        class="form-control"
                                        name="skype"
                                        id="skype"
                                        type="text"
                                        autocomplete="tel"
                                    >

                                    <p class="help-block help-block-error"></p>

                                </div>

                                <div class="form-group">

                                    <label class="control-label" for="password">

                                        [signup.form.password]

                                    </label>

                                    <input
                                        class="form-control"
                                        name="password"
                                        id="password"
                                        required
                                        type="password"
                                        autocomplete="new-password"
                                    >

                                    <p class="help-block help-block-error"></p>

                                </div>

                                <div class="form-group">

                                    <label class="control-label" for="rpassword">

                                        [signup.form.rpassword]

                                    </label>

                                    <input
                                        class="form-control"
                                        name="rpassword"
                                        id="rpassword"
                                        required
                                        type="password"
                                        autocomplete="new-password"
                                    >

                                    <p class="help-block help-block-error"></p>

                                </div>

                                <div
                                    class="form-group sq-signup-terms"
                                    style="[signup.terms-field]"
                                >

                                    <div class="checkbox">

                                        <label>

                                            <input
                                                type="checkbox"
                                                class="terms-accept-checkbox"
                                                name="tnc"
                                                value="1"
                                            >

                                            <span>

                                                I have read and agreed with

                                                <a href="/terms" target="_blank" rel="noopener">

                                                    Terms &amp; Conditions

                                                </a>

                                            </span>

                                        </label>

                                    </div>

                                </div>

                                [panel.signup.csrf_protection]

                                <div class="sq-signup-recaptcha">

                                    <div
                                        class="g-recaptcha form-group"
                                        data-sitekey="[panel.google-sitekey]"
                                    ></div>

                                </div>

                                <input type="hidden" name="singup" value="Sign Up">

                                <button
                                    type="submit"
                                    class="btn btn-default sq-signup-submit"
                                >

                                    [signup.form.submit_button]

                                </button>

                                <div class="sq-signup-security">

                                    <span>●</span>

                                    <span>Your account details are submitted securely</span>

                                </div>

                            </div>

                        </form>

                        <div class="sq-signup-login">

                            <span>[signup.form.login_button_label]</span>

                            <a href="/login">

                                [signup.form.login_button]

                            </a>

                        </div>

                    </div>

                </div>

            </section>

        </div>

    </div>

</div>

<script>
    function page_load(form)
    {
        form = form || document.getElementById("yw0");

        if (!form)
        {
            return false;
        }

        if (form.getAttribute("data-submitting") === "1")
        {
            return false;
        }

        form.setAttribute("data-submitting", "1");

        var button = form.querySelector(
            'button[type="submit"]'
        );

        if (button)
        {
            button.disabled = true;
            button.setAttribute("aria-busy", "true");
            button.setAttribute(
                "data-original-text",
                button.textContent
            );
            button.textContent = "Creating Account...";
        }

        try
        {
            if (typeof window.gtag === "function")
            {
                window.gtag("event", "conversion", {
                    "send_to": "AW-828508229/8tf-COLX6PICEMWQiIsD",
                    "transport_type": "beacon"
                });
            }
        }
        catch (error)
        {
            console.warn(
                "Signup conversion tracking could not run.",
                error
            );
        }

        window.setTimeout(function ()
        {
            try
            {
                form.submit();
            }
            catch (error)
            {
                form.removeAttribute("data-submitting");

                if (button)
                {
                    button.disabled = false;
                    button.removeAttribute("aria-busy");

                    var originalText =
                        button.getAttribute("data-original-text");

                    if (originalText)
                    {
                        button.textContent = originalText;
                    }
                }

                console.error(
                    "Signup form submission failed.",
                    error
                );
            }
        }, 350);

        return false;
    }
</script>

<!--
Perfect Panel functional elements retained:
1. Native empty form action
2. full_name, username, email, skype, password, rpassword fields
3. signup field visibility placeholders
4. terms field visibility placeholder
5. panel signup CSRF protection
6. Google reCAPTCHA site key placeholder
7. hidden name="singup" value
8. native submit behaviour
9. signup error message
10. login label and login link

Important reliability fix:
Perfect Panel's original delayed form submission flow is restored.
The hidden terms field no longer blocks browser validation.
Conversion tracking is optional and cannot stop registration.
-->